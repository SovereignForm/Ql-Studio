  "type": "module",
  "description": "Ql Studio — High-Performance DAW Engine (React + Tailwind + Canvas + Tauri v2 Rust Core)",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri:dev": "vite build && cargo run --manifest-path src-tauri/Cargo.toml",
