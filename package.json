    "verify": "node src/verifyEngine.ts",
    "verify:ts": "node src/verifyEngine.ts",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
